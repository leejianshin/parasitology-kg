{
  "narrative_intent_mapping": {
    "narrative_fact": {
      "authority": "reviewed narrative records with formal narrative role",
      "allowed_topics": [
        "morphology"
      ],
      "allowed_entity_types": [
        "life_cycle_stage"
      ],
      "allowed_event_types": [
        "DEVELOPMENT"
      ],
      "required_anchor_predicates": []
    },
    "diagnostic_evidence_integration": {
      "authority": "runtime-authority-projection.yml claims[].semantic_role",
      "allowed_topics": [
        "diagnosis",
        "boundary"
      ],
      "allowed_entity_types": [
        "diagnostic_method",
        "disease"
      ],
      "allowed_event_types": [
        "DIAGNOSTIC_FINDING",
        "EXPOSURE"
      ],
      "required_anchor_predicates": [
        "has_diagnostic_clue"
      ]
    },
    "diagnostic_confirmation_limit": {
      "authority": "runtime-authority-projection.yml claims[].semantic_role",
      "allowed_topics": [
        "diagnosis",
        "boundary"
      ],
      "allowed_entity_types": [
        "diagnostic_method",
        "disease"
      ],
      "allowed_event_types": [
        "DIAGNOSTIC_FINDING",
        "EXPOSURE"
      ],
      "required_anchor_predicates": [
        "has_diagnostic_clue"
      ]
    }
  },
  "event_to_narrative_derivation": {
    "applies_when": "narrative_intent.derivation_mode == EVENT_DERIVED",
    "rules": [
      "each E basis event_type is allowlisted by narrative_intent_mapping[semantic_role].allowed_event_types",
      "every concrete narrative entity is an event participant, method, target, or directly bound mention",
      "topic_scope and semantic_role are an allowlisted pair",
      "every required anchor predicate has an executable R intent sharing at least one identical AFFIRMED M/E root",
      "anchor R and N clause scopes overlap and both cover their shared root span"
    ],
    "unrelated_anchor_relation": "FAIL_CLOSED",
    "selector_contains_unbound_entity": "FAIL_CLOSED"
  },
  "direct_mention_to_narrative_derivation": {
    "applies_when": "narrative_intent.derivation_mode == DIRECT_MENTION_DERIVED",
    "rules": [
      "basis contains M IDs only",
      "concrete narrative entities occur in AFFIRMED basis mentions",
      "entity type, topic and semantic role satisfy narrative_intent_mapping",
      "required anchor R shares at least one identical AFFIRMED M root and clause scope"
    ]
  },
  "closed_contrast_intent_derivation": {
    "applies_when": "R/N derivation_mode == CLOSED_CONTRAST_DERIVED",
    "authority": "closed_contrast_derivations",
    "rules": [
      "activation_policy is REQUIRED_CONTRAST",
      "predicate or narrative role is exactly emitted by one closed rule",
      "selector entities and types follow the closed rule and formal predicate matrix",
      "emitted intent and required role share the same AFFIRMED M/E root"
    ],
    "unregistered_closed_rule": "FAIL_CLOSED"
  },
  "role_catalog": {
    "EVIDENCE_ROLE": {
      "epidemiologic_exposure_clue": {
        "authority": "reviewed semantic roles epidemiological_clue + not_confirmatory",
        "allowed_predicates": [
