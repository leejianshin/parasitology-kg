{
  "event_field_defaults": {
    "diagnostic": {
      "method_entity_id": "REQUIRED_REVIEWED_DIAGNOSTIC_METHOD",
      "specimen_code": "METHOD_CONSTRAINED",
      "finding_polarity": [
        "POSITIVE",
        "NEGATIVE"
      ]
    },
    "non_diagnostic": {
      "method_entity_id": null,
      "specimen_code": "NOT_APPLICABLE",
      "finding_polarity": "NOT_APPLICABLE"
    },
    "unresolved_material_field": "AMBIGUOUS_NO_RETRIEVAL"
  },
  "derivation_source_tokens": {
    "entity_type_token": "A token equal to a formal entity type resolves only to reviewed entity IDs of that type present in event.actor_entity_ids, event.target_entity_id, or mentions directly bound by event.mention_ids. It never authorizes another entity merely because that entity has the same type.",
    "method_entity_id": "Exactly event.method_entity_id; null contributes no entity.",
    "bound_mention_scope": "A bound mention must be in the event clause or a uniquely resolved reference-linked clause. Unrelated same-clause or same-type mentions are not event participants.",
    "open_type_selector": "An entity-type-only selector is permitted only when the corresponding subject_from/object_from list contains that type and the request explicitly asks for an unknown counterpart. It cannot hide an unresolved known entity.",
    "concrete_selector": "Every concrete selector entity ID must be in the deterministically resolved source set for its side. Adding an entity not present in that source set is EVENT_INTENT_DERIVATION_MISMATCH."
  },
  "event_to_relation_derivation": {
    "applies_when": "relation_intent.derivation_mode == EVENT_DERIVED",
    "rules": [
      "each E basis resolves to exactly one event",
      "relation predicate exists in every material E basis event_mapping[event_type].predicates",
      "subject selector is derived only from that predicate subject_from tokens",
      "object selector is derived only from that predicate object_from tokens",
      "all concrete selector entities occur in the deterministic event source set",
      "all E bases share the relation intent clause/source-span scope",
      "an unrelated M basis cannot repair an E-to-predicate mismatch"
    ],
    "zero_matching_event_predicate": "FAIL_CLOSED",
    "selector_contains_unbound_entity": "FAIL_CLOSED"
  },
  "direct_mention_to_relation_derivation": {
    "applies_when": "relation_intent.derivation_mode == DIRECT_MENTION_DERIVED",
    "rules": [
      "basis contains M IDs only",
      "every concrete selector entity occurs in an AFFIRMED basis mention",
      "open entity-type slots follow predicate_type_matrix and are explicitly requested",
      "predicate and direction are expressed by exact request spans"
    ],
    "inferred_concrete_entity_not_in_basis": "FAIL_CLOSED"
  },
